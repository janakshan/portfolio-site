# OPTIONAL. The live form ID is already committed in content/site.ts, so the
# contact form works without any environment configuration.
#
# Set this only to point a particular environment at a DIFFERENT Formspree form
# — e.g. a throwaway form for a staging deploy, so test submissions don't land
# in your real inbox. Value is the last segment of https://formspree.io/f/<id>.
NEXT_PUBLIC_FORMSPREE_ID=

# OPTIONAL. Canonical origin for sitemap, OG tags and structured data.
# Falls back to Vercel's production domain, then to `url` in content/site.ts.
NEXT_PUBLIC_SITE_URL=
